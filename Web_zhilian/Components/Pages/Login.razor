@page "/login"
@layout NullLayout
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<h3>登录页面</h3>

<div style="padding: 100px 100px 10px;">
        <div class="input-group">
            <span class="input-group-addon">账号</span>
            <input type="text" class="form-control" @bind="username">
        </div>
        <br>
        <div class="input-group">
            <span class="input-group-addon">密码</span>
            <input type="password" class="form-control" @bind="password">
        </div>
        <br>
        <div class="input-group">
            <button @onclick="logen1" class="btn btn-primary">登录</button>
        </div>
</div>

@code {
    private string? username;
    private string? password;

    private async void logen1()
    {
        try
        {
            string t = YK.wqh_zl_user.Authentication(username, password);
            await JS.InvokeVoidAsync("SaveToken", t);
            NavigationManager.NavigateTo("/");
        }
        catch(Exception e)
        {
            await JS.InvokeVoidAsync("displayTickerAlert", e.Message);
        }
    }
}
