@page "/CG"
@inject IJSRuntime JS
@rendermode InteractiveServer
@inject NavigationManager NavigationManager


<h1>采购数据</h1>


<div class="container-fluid">
    <input type="date" @bind="startdate">
    <input type="date" @bind="enddate">
    <input type="text" placeholder="通用名" @bind="goodsid" @bind:event="oninput"/>
    <input type="text" placeholder="批号" @bind="lotno" @bind:event="oninput" />
    <input type="text" placeholder="上市许可持有人" @bind="holdersname" @bind:event="oninput" />
    <input type="text" placeholder="生产企业" @bind="factoryname" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="getlist">查询</button>
    <button class="btn btn-primary" @onclick="toExcel">导出Excel下载</button>
    <div class="container-fluid table-responsive">
        @if (list?.Count > 0)
        {
            <table class="table">
                <tbody>
                    <tr>
                        <td class="col-sm-1"><a @onclick="@(n => Sorter("CREDATE"))">日期</a></td>
                        <td class="col-sm-1">单据类型</td>
                        <td class="col-sm-1">供应商</td>
                        <td class="col-sm-1">货品ID</td>
                        <td class="col-sm-1"><a @onclick="@(e => Sorter("GOODSNAME"))">通用名</a></td>
                        <td class="col-sm-1">上市许可持有人</td>
                        <td class="col-sm-1">生产企业</td>
                        <td class="col-sm-1">规格</td>
                        <td class="col-sm-1">批准文号</td>
                        <td class="col-sm-1">单位</td>
                        <td class="col-sm-1">批号</td>
                        <td class="col-sm-1">生产日期</td>
                        <td class="col-sm-1">效期</td>
                        <td class="col-sm-1">数量</td>
                        <td class="col-sm-1">单价</td>
                        <td class="col-sm-1">金额</td>
                    </tr>
                    @foreach (var mx in list)
                    {
                        <tr>
                            <td class="col-sm-1">@mx.CREDATE.ToString("yyyy-MM-dd")</td>
                            <td class="col-sm-1">@mx.COMEFROM</td>
                            <td class="col-sm-1">@mx.SUPPLYNAME</td>
                            <td class="col-sm-1">@mx.GOODSID</td>
                            <td class="col-sm-1">@mx.GOODSNAME</td>
                            <td class="col-sm-1">@mx.HOLDERSNAME</td>
                            <td class="col-sm-1">@mx.FACTORYNAME</td>
                            <td class="col-sm-1">@mx.GOODSTYPE</td>
                            <td class="col-sm-1">@mx.APPROVEDOCNO</td>
                            <td class="col-sm-1">@mx.GOODSUNIT</td>
                            <td class="col-sm-1">@mx.LOTNO</td>
                            <td class="col-sm-1">@mx.PRODDATE.ToString("yyyy-MM-dd")</td>
                            <td class="col-sm-1">@mx.INVALIDDATE.ToString("yyyy-MM-dd")</td>
                            <td class="col-sm-1">@mx.GOODSQTY</td>
                            <td class="col-sm-1">@mx.UNITPRICE</td>
                            <td class="col-sm-1">@mx.TOTAL_LINE</td>
                        </tr>
                    }
                    <tr>
                        <td class="col-sm-1">合计</td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1">@sum_shl</td>
                        <td class="col-sm-1"></td>
                        <td class="col-sm-1">@sum_je</td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<YK.CG>? list;

    private YK.wqh_zhilian_user? user;

    private string? v;
    private string goodsid = "";
    private string lotno = "";
    private string holdersname = "";
    private string factoryname = "";

    private int sum_shl = 0;
    private decimal sum_je = 0;

    private DateTime startdate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime enddate = DateTime.Now;

    protected override async Task OnAfterRenderAsync(Boolean f)
    {
        try
        {
            if (f)
            {
                string token = new(await JS.InvokeAsync<string>("Get_token"));
                if (string.IsNullOrWhiteSpace(token)) { NavigationManager.NavigateTo("/login"); return; }
                user = YK.Token.Verify_token(token);
                v = user.CG_VIEW;
            }
        }
        catch (Exception e)
        {
            NavigationManager.NavigateTo("/login");
            await JS.InvokeVoidAsync("displayTickerAlert", e.Message);
        }
    }


    private async void getlist()
    {
        
        list = YK.CG.getList(v, startdate, enddate, goodsid, lotno, holdersname, factoryname);
        if (list.Count < 1) await JS.InvokeVoidAsync("displayTickerAlert", "当前无数据！");

        sum_shl = 0;
        sum_je = 0;

        foreach (YK.CG i in list)
        {
            sum_shl += i.GOODSQTY;
            sum_je += i.TOTAL_LINE;
        }
    }

    private async void toExcel()
    {
        if (list.Count < 1) { await JS.InvokeVoidAsync("displayTickerAlert", "当前无数据！"); return; }

        string filename = string.Format("{0}_{1}.xlsx", user.USERNAME, DateTime.Now.ToString("yyyyMMdd"));

        NPOI.SS.UserModel.IWorkbook workbook = ExcelHelp.toExcel<YK.CG>(list);

        using (FileStream fileStream = new FileStream("./temp/" + filename, FileMode.Create, FileAccess.Write))
        {
            workbook.Write(fileStream);
        }

        try
        {
            var fileStream = File.OpenRead("./temp/" + filename);
            using var streamRef = new DotNetStreamReference(stream: fileStream);
            await JS.InvokeVoidAsync("downloadFileFromStream", filename, streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("displayTickerAlert", ex.Message);
        }
    }


    private void Sorter(string str)
    {
        switch (str)
        {
            case "CREDATE":
                list = list?.OrderBy(n => n.CREDATE).ToList();
                break;
            case "GOODSNAME":
                list = list?.OrderBy(n => n.GOODSNAME).ToList();
                break;
        }
    }
}
