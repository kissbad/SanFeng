<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="yjj_qyjk_bhg"
    targetNamespace="http://cmsland.com/yjj_qyjk_bhg.xsd"
    elementFormDefault="qualified"
    xmlns="http://cmsland.com/yjj_qyjk_bhg.xsd"
    xmlns:jks="http://cmsland.com/yjj_qyjk_bhg.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>
  <xs:annotation>
    <xs:documentation xml:lang="zh-cn">
      企业数据上报接口
      不合格药品记录xml架构文件
    </xs:documentation>
  </xs:annotation>

  <!--根元素 不合格药品记录单据 一个文件只允许包含一个不合格药品记录单据-->
  <xs:element name="dj">
    <!--单据类型定义-->
    <xs:complexType>
      <xs:sequence>
        <!--单据允许一或多个条目-->
        <xs:element name="tm"  type="t_tm" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

 
  <!--单据条目类型-->
  <xs:complexType name="t_tm">
    <xs:attributeGroup ref="ag_tm"/>
  </xs:complexType>

  <!--单据条目属性组定义-->
  <xs:attributeGroup name="ag_tm">
    <!--药品本位码-->
    <xs:attribute name="bwm" use="required">
      <!--内容限定：14位连续0到9数字-->
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9]{14}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>

    <!--药品包装规格-->
    <xs:attribute name="bzgg" use="required">
      <!--内容限定：非空字符串;最大长度200；首尾无空格；中间无连续空格；无换行符、回车或制表符-->
      <xs:simpleType>
        <xs:restriction base="xs:token">
          <xs:maxLength value="200"/>
          <xs:pattern value=".+"/>          
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>

    <!--药品生产批号-->
    <xs:attribute name="scph" use="required">
      <!--内容限定：非空字符串;最大长度50；首尾无空格；中间无连续空格；无换行符、回车或制表符-->
      <xs:simpleType>
        <xs:restriction base="xs:token">
          <xs:maxLength value="50"/>
          <xs:pattern value=".+"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>

    <!--药品生产日期-->
    <xs:attribute name="scrq" type="xs:date" use="required"/>

    <!--药品有效期至 药品有效期截至日期-->
    <xs:attribute name="yxqz" type="xs:date" use="required"/>
    
    <!--不合格数量 必须为大于0正整数-->
    <xs:attribute name="sl" type="xs:positiveInteger" use="required"/>

    <!--不合格原因-->
    <xs:attribute name="yy" use="required">
      <!--内容限定：非空字符串;最大长度50；首尾无空格；中间无连续空格；无换行符、回车或制表符-->
      <xs:simpleType>
        <xs:restriction base="xs:token">
          <xs:maxLength value="50"/>
          <xs:pattern value=".+"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    
    <!--是否已处理-->
    <xs:attribute name="sfcl" type="xs:boolean" use="required"/>

    <!--处理方式-->
    <xs:attribute name="clfs">
      <xs:simpleType>
        <xs:restriction base="xs:token">
          <xs:maxLength value="50"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>

    <!--处理日期-->
    <xs:attribute name="clrq" type="xs:date"/>

    <!--备注-->
    <xs:attribute name="bz">
      <xs:simpleType>
        <xs:restriction base="xs:token">
          <xs:maxLength value="200"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>
</xs:schema>
