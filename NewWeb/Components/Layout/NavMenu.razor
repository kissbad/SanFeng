<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="ZL">NewWeb</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ZL/CG" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> 采购
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ZL/KC">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> 库存
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ZL/XS">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 销售
            </NavLink>
        </div>

        @foreach (var mx in pf_list)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@mx.b">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @mx.a
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private List<test> pf_list = null;

    public class test
    {
        public string a { get; set; }
        public string b { get; set; }
    }

    protected override void OnParametersSet()
    {
        pf_list = new List<test>();
        pf_list.Add(new test { a = "111111", b = "sdasdas" });
        pf_list.Add(new test { a = "222222", b = "sdasdas" });
    }

}

